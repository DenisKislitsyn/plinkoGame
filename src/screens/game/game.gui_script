local consts = require "common.consts"
local level_store = require "common.level_store"
local monarch = require "monarch.monarch"
local druid = require "druid.druid"

local COLORS_X2 = {
	[true] = vmath.vector4(0.85, 0.35, 0.1, 1),
	[false] = vmath.vector4(1, 1, 1, 1),
}

local function apply_ui(self, message)
	gui.set_text(self.text_balls, string.format("Balls: %d", message.balls or 0))
	gui.set_text(self.text_score, string.format("Score: %d", message.score or 0))

	local regen = message.regen
	if regen == nil then
		gui.set_text(self.text_regen, "Regen: --")
	else
		gui.set_text(self.text_regen, string.format("Regen: %.0fs", regen))
	end

	local many = message.drop_many_count
	if many then
		gui.set_text(self.drop_many_btn_text, string.format("DROP %d", many))
	end

	gui.set_color(self.x2_btn_text, COLORS_X2[message.speed_x2 or false])
end

local function post_game(message_id, message)
	msg.post(consts.URL.GAME_SCRIPT, message_id, message or {})
end

local function cfg()
	return level_store.get().game
end

function init(self)
	gui.set_render_order(4)
	msg.post(".", "acquire_input_focus")

	self.druid = druid.new(self)

	self.text_balls = gui.get_node("text_balls")
	self.text_regen = gui.get_node("text_regen")
	self.text_score = gui.get_node("text_score")
	self.x2_btn_text = gui.get_node("x2_btn_text")
	self.drop_many_btn_text = gui.get_node("drop_many_btn_text")

	gui.set_text(self.drop_many_btn_text, string.format("DROP %d", cfg().drop_many_count))

	self.druid:new_button("back_btn", function()
		monarch.show(monarch.scr.main_menu)
	end)
	self.druid:new_button("drop_btn", function()
		post_game(consts.MSG.DROP_BALL)
	end)
	self.druid:new_button("drop_many_btn", function()
		post_game(consts.MSG.DROP_MANY, { count = cfg().drop_many_count })
	end)
	self.druid:new_button("add_btn", function()
		post_game(consts.MSG.ADD_BALLS, { count = cfg().cheat_add_balls })
	end)
	self.druid:new_button("x2_btn", function()
		post_game(consts.MSG.TOGGLE_SPEED)
	end)

	post_game(consts.MSG.REQUEST_UI)
end

function final(self)
	self.druid:final()
end

function on_message(self, message_id, message, sender)
	if message_id == consts.MSG.UI_UPDATE then
		apply_ui(self, message)
	end
	self.druid:on_message(message_id, message, sender)
end

function on_input(self, action_id, action)
	return self.druid:on_input(action_id, action)
end
